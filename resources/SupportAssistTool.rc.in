#include <windows.h>
#include "@SUPPORT_ASSIST_RESOURCE_HEADER@"

IDI_SUPPORT_ASSIST_APP ICON "@SUPPORT_ASSIST_APP_ICON@"

1 RT_MANIFEST "@SUPPORT_ASSIST_APP_MANIFEST@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @SUPPORT_ASSIST_VERSION_COMMA@
 PRODUCTVERSION @SUPPORT_ASSIST_VERSION_COMMA@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "@SUPPORT_ASSIST_COMPANY_NAME@\0"
      VALUE "FileDescription", "@SUPPORT_ASSIST_PRODUCT_NAME@ - Support Engineering Toolkit\0"
      VALUE "FileVersion", "@PROJECT_VERSION@\0"
      VALUE "InternalName", "@SUPPORT_ASSIST_EXECUTABLE@\0"
      VALUE "OriginalFilename", "@SUPPORT_ASSIST_EXECUTABLE@.exe\0"
      VALUE "ProductName", "@SUPPORT_ASSIST_PRODUCT_NAME@\0"
      VALUE "ProductVersion", "@PROJECT_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
