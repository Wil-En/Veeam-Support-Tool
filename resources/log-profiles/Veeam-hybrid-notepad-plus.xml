<NotepadPlus>
    <UserLang name="Veeam-hybrid" ext="log" darkModeTheme="yes" udlVersion="2.1">
        <Settings>
            <Global caseIgnored="yes" allowFoldOfComments="no" foldCompact="no" forcePureLC="2" decimalSeparator="0" />
            <Prefix Keywords1="yes" Keywords2="yes" Keywords3="yes" Keywords4="yes" Keywords5="yes" Keywords6="yes" Keywords7="yes" Keywords8="yes" />
        </Settings>
        <KeywordLists>
            <Keywords name="Comments">00# 01 02((EOL)) 03&lt;!-- 04--&gt;</Keywords>
            <Keywords name="Numbers, prefix1"></Keywords>
            <Keywords name="Numbers, prefix2"></Keywords>
            <Keywords name="Numbers, extras1"></Keywords>
            <Keywords name="Numbers, extras2"></Keywords>
            <Keywords name="Numbers, suffix1">.</Keywords>
            <Keywords name="Numbers, suffix2">.</Keywords>
            <Keywords name="Numbers, range"></Keywords>
            <Keywords name="Operators1">@ &lt; &gt; \&lt; \&gt; \\ \` \* \_ \{ \} \[ \] \( \) \# \+ \- \. \! \~ \| |:-: |:--: |:---: | :-: :--: :---: :|: |: :|</Keywords>
            <Keywords name="Operators2">- + :- :-- :--- :</Keywords>
            <Keywords name="Folders in code1, open"></Keywords>
            <Keywords name="Folders in code1, middle"></Keywords>
            <Keywords name="Folders in code1, close"></Keywords>
            <Keywords name="Folders in code2, open">&quot;Starting new log&quot;</Keywords>
            <Keywords name="Folders in code2, middle"></Keywords>
            <Keywords name="Folders in code2, close">===================================================================</Keywords>
            <Keywords name="Folders in comment, open"></Keywords>
            <Keywords name="Folders in comment, middle"></Keywords>
            <Keywords name="Folders in comment, close"></Keywords>
            <Keywords name="Keywords1">../ (../ http:// (http:// https:// (https:// mailto: (mailto: ftp:// (ftp:// ftps:// (ftps:// (/ /</Keywords>
            <Keywords name="Keywords2">==== ----</Keywords>
            <Keywords name="Keywords3">*** ___&#x000D;&#x000A;**Job session is running in *&#x000D;&#x000A;Found driver&#x000D;&#x000A;Added&#x000D;&#x000A;**database name</Keywords>
            <Keywords name="Keywords4">** __&#x000D;&#x000A;Successful&#x000D;&#x000A;Success&#x000D;&#x000A;Completed&#x000D;&#x000A;Starting backup&#x000D;&#x000A;Cleaned</Keywords>
            <Keywords name="Keywords5">* _&#x000D;&#x000A;** Job Settings&#x000D;&#x000A;**The following volumes should be added to the snapshot set&#x000D;&#x000A;Full&#x000D;&#x000A;Incremental&#x000D;&#x000A;Protection Group&#x000D;&#x000A;Database &apos;**&apos;</Keywords>
            <Keywords name="Keywords6">** __&#x000D;&#x000A;Warning&#x000D;&#x000A;WARN</Keywords>
            <Keywords name="Keywords7">* _&#x000D;&#x000A;Error&#x000D;&#x000A;ERR</Keywords>
            <Keywords name="Keywords8">IPAddresses:&#x000D;&#x000A;ips:&#x000D;&#x000A;</Keywords>
            <Keywords name="Delimiters">00![ 00[ 01\ 02] 02] 03``` 03` 03~~~ 04\ 05``` 05((EOL `)) 05~~~ 06*** 07\ 08((EOL ***)) 09** 10\ 11((EOL **)) 12* 13\ 14((EOL *)) 15** 16\ 17((EOL **)) 18* 19\ 20((EOL *)) 21 22 23</Keywords>
        </KeywordLists>
        <Styles>
            <WordsStyle name="DEFAULT" fgColor="DCDCCC" bgColor="3F3F3F" colorStyle="0" fontStyle="0" nesting="0" />
            <WordsStyle name="COMMENTS" fgColor="7F9F7F" bgColor="3F3F3F" colorStyle="1" fontStyle="2" nesting="0" />
            <WordsStyle name="LINE COMMENTS" fgColor="FF8040" bgColor="3F3F3F" colorStyle="1" fontStyle="1" nesting="0" />
            <WordsStyle name="NUMBERS" fgColor="8CD0D3" bgColor="3F3F3F" colorStyle="1" fontStyle="0" nesting="0" />
            <WordsStyle name="KEYWORDS1" fgColor="EDD6ED" bgColor="3F3F3F" colorStyle="1" fontStyle="0" nesting="0" />
            <WordsStyle name="KEYWORDS2" fgColor="FF8040" bgColor="3F3F3F" colorStyle="1" fontStyle="1" nesting="0" />
            <WordsStyle name="KEYWORDS3" fgColor="E3CEAB" bgColor="3F3F3F" colorStyle="1" fontStyle="3" nesting="0" />
            <WordsStyle name="KEYWORDS4" fgColor="00FF40" bgColor="3F3F3F" colorStyle="1" fontStyle="1" nesting="0" />
            <WordsStyle name="KEYWORDS5" fgColor="E3CEAB" bgColor="3F3F3F" colorStyle="1" fontStyle="1" nesting="0" />
            <WordsStyle name="KEYWORDS6" fgColor="FF8000" bgColor="3F3F3F" colorStyle="1" fontStyle="1" nesting="0" />
            <WordsStyle name="KEYWORDS7" fgColor="FF0000" bgColor="3F3F3F" colorStyle="1" fontStyle="3" nesting="0" />
            <WordsStyle name="KEYWORDS8" fgColor="FFFF00" bgColor="3F3F3F" colorStyle="1" fontStyle="0" nesting="0" />
            <WordsStyle name="OPERATORS" fgColor="DFC47D" bgColor="3F3F3F" colorStyle="1" fontStyle="1" nesting="0" />
            <WordsStyle name="FOLDER IN CODE1" fgColor="DCDCCC" bgColor="3F3F3F" colorStyle="0" fontStyle="0" nesting="0" />
            <WordsStyle name="FOLDER IN CODE2" fgColor="DCDCCC" bgColor="3F3F3F" colorStyle="0" fontStyle="5" fontSize="18" nesting="0" />
            <WordsStyle name="FOLDER IN COMMENT" fgColor="DCDCCC" bgColor="3F3F3F" colorStyle="0" fontStyle="0" nesting="0" />
            <WordsStyle name="DELIMITERS1" fgColor="EDD6ED" bgColor="3F3F3F" colorStyle="1" fontStyle="2" nesting="0" />
            <WordsStyle name="DELIMITERS2" fgColor="CEDF99" bgColor="3F3F3F" colorStyle="1" fontStyle="0" nesting="0" />
            <WordsStyle name="DELIMITERS3" fgColor="E3CEAB" bgColor="3F3F3F" colorStyle="1" fontStyle="3" nesting="0" />
            <WordsStyle name="DELIMITERS4" fgColor="E3CEAB" bgColor="3F3F3F" colorStyle="1" fontStyle="1" nesting="65600" />
            <WordsStyle name="DELIMITERS5" fgColor="E3CEAB" bgColor="3F3F3F" colorStyle="1" fontStyle="2" nesting="32800" />
            <WordsStyle name="DELIMITERS6" fgColor="E3CEAB" bgColor="3F3F3F" colorStyle="1" fontStyle="3" nesting="0" />
            <WordsStyle name="DELIMITERS7" fgColor="E3CEAB" bgColor="3F3F3F" colorStyle="1" fontStyle="3" nesting="0" />
            <WordsStyle name="DELIMITERS8" fgColor="DCDCCC" bgColor="3F3F3F" colorStyle="0" fontStyle="0" nesting="0" />
        </Styles>
    </UserLang>
</NotepadPlus>
