{
  "name": "libssh2",
  "version": "1.11.1",
  "port-version": 100,
  "description": "The SSH library - SAT overlay port patched for CVE-2026-55200",
  "homepage": "https://www.libssh2.org",
  "license": "BSD-3-Clause",
  "dependencies": [
    { "name": "vcpkg-cmake", "host": true },
    { "name": "vcpkg-cmake-config", "host": true }
  ],
  "default-features": [ "openssl", "zlib" ],
  "features": {
    "openssl": {
      "description": "Use OpenSSL as the crypto backend",
      "dependencies": [ "openssl" ]
    },
    "zlib": {
      "description": "Enable zlib compression",
      "dependencies": [ "zlib" ]
    }
  }
}
