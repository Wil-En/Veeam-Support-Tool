      "configurePreset": "linux-headless-release"
    },
    {
      "name": "portable-linux-debug",
      "configurePreset": "portable-linux-debug"
    },
    {
      "name": "portable-linux-archive-debug",
      "configurePreset": "portable-linux-archive-debug"
    },
    {
      "name": "linux-x64-release",
      "configurePreset": "linux-x64-release"
    },
    {
      "name": "macos-native-debug",
      "configurePreset": "macos-native-debug"
    },
    {
